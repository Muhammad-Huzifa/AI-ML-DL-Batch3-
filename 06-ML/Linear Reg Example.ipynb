   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x=np.array([1,2,3,])\n",
    "y=np.array([3,5,7])\n",
    "m=(y[1]-y[0])/(x[1]-x[0])\n",
    "b=y[0]-m*x[0]\n",
    "\n",
    "y=m *x + b\n",
    "plt.title(\"Made BY wwww\")\n",
    "plt.xlabel('x')\n",
    "plt.ylabel('y')\n",
    "plt.plot(y)"
   ]
  }
