    {
      "path": "modules/01-python",
      "title": "Python foundations",
      "summary": "Variables, control flow, collections, functions, files, exceptions, and object-oriented programming.",
      "prerequisites": "Python 3.11; no data-science packages needed for the basic examples."
    },
    {
      "path": "modules/02-numpy",
      "title": "NumPy",
      "summary": "Arrays, indexing, broadcasting, vectorized operations, and saving/loading numerical data.",
      "prerequisites": "Python foundations; base environment. The image-indexing section also needs the image extra."
    },
    {
      "path": "modules/03-pandas",
      "title": "Pandas",
      "summary": "Series and DataFrames, selection, missing values, grouping, and working with CSV/JSON data.",
      "prerequisites": "Python and NumPy; base environment."
    },
    {
      "path": "modules/04-data-visualization",
      "title": "Data visualization",
      "summary": "Matplotlib and Seaborn charts, distributions, and exploratory analysis of the diabetes teaching dataset.",
      "prerequisites": "NumPy and Pandas; base environment."
    },
    {
      "path": "modules/05-statistics-and-probability",
      "title": "Statistics and probability",
      "summary": "Descriptive statistics, measures of spread, probability, and sampling examples.",
      "prerequisites": "NumPy and data visualization; base environment."
    },
    {
      "path": "modules/06-machine-learning",
      "title": "Machine learning",
      "summary": "Linear and multiple regression, gradient descent, and linear/polynomial support vector machines.",
      "prerequisites": "Pandas, statistics, and train/test evaluation; base environment."
    },
    {
      "path": "modules/07-deep-learning",
      "title": "Deep learning",
      "summary": "Dense neural networks, MNIST, regularization, LeNet, AlexNet, VGG16, and ResNet examples.",
      "prerequisites": "Machine learning; TensorFlow environment. Some CNN lessons require externally supplied images."
    },
    {
      "path": "modules/08-natural-language-processing",
      "title": "Natural language processing",
      "summary": "Text preparation and sentiment classification using recurrent neural networks.",
      "prerequisites": "Deep learning; TensorFlow environment. Start with the bundled mock product reviews."
    }
  ],
